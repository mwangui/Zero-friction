{
  "name": "PulseFabric Monitor",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [4200, 3000],
  "portsAttributes": {
    "4200": { "label": "Angular Frontend", "onAutoForward": "notify" },
    "3000": { "label": "Backend API", "onAutoForward": "notify" }
  },
  "hostRequirements": {
    "cpus": 8,
    "memory": "16gb"
  },
  "updateContentCommand": "pip install fastapi uvicorn[standard] && npm install && npm install -g @angular/cli@21 && cd frontend && npm ci --prefer-offline --no-audit",
  "postCreateCommand": "git checkout -b feat/$(echo $GITHUB_USER)-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true",
  "postStartCommand": "cd /workspaces/Zero-friction && git pull origin main || true",
  "remoteEnv": {
    "CI": "1",
    "NG_CLI_ANALYTICS": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "git.branchProtection": ["main"],
        "git.branchProtectionPrompt": "alwaysCommitToNewBranch",
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.languageServer": "Pylance"
      }
    }
  }
}